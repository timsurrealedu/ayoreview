# ==============================================================================
# ReviewTap V1.1 Production Environment Configuration
# ==============================================================================

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production Domain & App URL
NEXT_PUBLIC_APP_URL=https://reviewtap.id

# Platform Operator Admin Authorization (comma-separated admin emails)
ADMIN_EMAILS=admin@reviewtap.id,timothy@reviewtap.id

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=reviewtap
SENTRY_PROJECT=reviewtap-app
