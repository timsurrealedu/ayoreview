# ==============================================================================
# AyoReview Production Environment Configuration
# ==============================================================================

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production Domain & App URL
NEXT_PUBLIC_APP_URL=https://ayoreview.id

# Platform Operator Admin Authorization (comma-separated admin emails)
ADMIN_EMAILS=admin@ayoreview.id,tim@ayoreview.id

# Visitor IP hashing key (HMAC-SHA-256). Generate: openssl rand -hex 32
# Required in production — without it interactions record ip_hash='anonymous'.
IP_HASH_SECRET=generate-with-openssl-rand-hex-32

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=reviewtap
SENTRY_PROJECT=reviewtap-app

# Google Places API (New) for Merchant Onboarding / Place Lookup
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Midtrans (Snap) — card order payments: QRIS, GoPay, ShopeePay, bank VA, cards
# Get keys at https://dashboard.sandbox.midtrans.com (sandbox) / app.midtrans.com (production)
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false

# Stripe — used only for the Rp 5.000/month setup-wizard subscription

# Physical card order (one-time payment). Price in whole rupiah (IDR is zero-decimal in Stripe)
CARD_PRICE_IDR=30000
