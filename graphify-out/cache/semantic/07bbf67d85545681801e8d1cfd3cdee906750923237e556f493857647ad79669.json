{"nodes": [{"id": "prd_smart_review_card_platform_v1", "label": "PRD \u2014 Smart Review Card Platform V1", "file_type": "document", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_reviewtap", "label": "ReviewTap (Product)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 goal is not a complete reputation-management platform; it validates that businesses use the product, keep cards deployed, care about analytics, and eventually pay."}, {"id": "prd_redirect_architecture", "label": "Redirect Architecture (Core Product Principle)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR code and NFC tag must never directly encode the Google Review URL \u2014 both encode a ReviewTap-owned redirect URL so the destination can be changed remotely, cards never need reprinting or reprogramming, interactions are measurable, cards can be disabled/tracked/reassigned, and businesses depend on the software rather than the NFC hardware."}, {"id": "prd_organization", "label": "Organization (FR-003)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organization layer introduced above Business even though V1 users typically own a single business, to prevent future data restructuring."}, {"id": "prd_business", "label": "Business (FR-004)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletion is soft deletion via archived_at."}, {"id": "prd_location", "label": "Location (FR-005)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_card", "label": "Card (FR-007)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must not expose sequential database IDs; use random secure IDs (NanoID or UUID-derived slug), 6-10 characters."}, {"id": "prd_interaction", "label": "Interaction Tracking (FR-010)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store only card_id, source, timestamp minimum; do not store unnecessary personally identifying data (privacy by minimization)."}, {"id": "prd_redirect_endpoint", "label": "Redirect Endpoint (FR-009: GET /q/:publicId, GET /n/:publicId)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirect customer takes priority over recording analytics; logging failure should never prevent the customer reaching Google. Log asynchronously / fire-and-forget, then 302 redirect."}, {"id": "prd_analytics_dashboard", "label": "Analytics Dashboard (FR-012)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_admin_dashboard", "label": "Admin Dashboard (FR-019)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_qr_generator", "label": "QR Generator (FR-015)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR generation must not rely on an external third-party service; must support SVG and PNG with sufficient error correction to remain scannable when printed."}, {"id": "prd_onboarding", "label": "Onboarding Wizard (FR-017)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target: new merchant configures first digital card in under 3 minutes; business owners frequently operate from phones so UI must be mobile-first."}, {"id": "prd_bot_filtering", "label": "Basic Bot Filtering (FR-011)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perfect bot detection is not required; bot interactions just must not appear in default merchant analytics."}, {"id": "prd_card_inventory_code", "label": "Card Inventory Code (FR-021, RT-XXXXXX)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate from customer-facing branding; used to identify cards during support, track inventory, replace damaged cards, and reassign cards."}, {"id": "prd_north_star_metric", "label": "North Star Metric: Monthly Review Page Visits", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures whether the product is actually being used in the physical world."}, {"id": "prd_review_page_visits", "label": "Review Page Visits (FR-013 Primary Metric)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never label interactions as 'Reviews generated' unless ReviewTap can prove a review was submitted; use Review Page Visits / Card Interactions / QR Scans / NFC Taps instead."}, {"id": "prd_nextjs", "label": "Next.js (Frontend)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_supabase", "label": "Supabase (Managed PostgreSQL + Auth)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_postgresql", "label": "PostgreSQL (Database)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_vercel", "label": "Vercel (Hosting)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_ntag213", "label": "NTAG213 NFC Chip", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because it is inexpensive, broadly compatible, has sufficient memory, and is suitable for URL storage."}, {"id": "prd_google_reviews", "label": "Google Reviews (Destination)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google Reviews is the initial wedge; future destinations (Instagram, WhatsApp, menus, loyalty, CRM) are explicitly deferred out of V1."}, {"id": "prd_open_redirect_protection", "label": "Open Redirect Protection (SR-005)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirect URL must never come from query parameters; destination must always come from server-side database configuration to prevent open-redirect abuse."}, {"id": "prd_destination_validation", "label": "Destination Validation (SR-004)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only https:// scheme approved; javascript:, file:, data: schemes must be blocked."}, {"id": "prd_rate_limiting", "label": "Rate Limiting (SR-006)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Basic limits on login, signup, card creation, and redirect endpoints if abuse occurs; redirect rate limiting must not affect legitimate high-volume business usage."}, {"id": "prd_v1_non_goals", "label": "V1 Non-Goals (Section 33)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI review generation/replies, sentiment analysis, WhatsApp automation, CRM, loyalty, custom landing pages, POS integration, review scraping, Stripe automation, mobile app, white-label, third-party API are all excluded because each creates scope creep before product-market validation."}, {"id": "prd_small_business_owner", "label": "Small Business Owner (Primary User)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_reviewtap_administrator", "label": "ReviewTap Administrator (Internal User)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_manual_card_assignment", "label": "Manual Card Assignment (FR-020)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Particularly important during pilots: admin pre-creates physical card inventory and assigns to business/location/placement, which dramatically simplifies deployment."}, {"id": "prd_object_authorization", "label": "Object Authorization (SR-002)", "file_type": "rationale", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every request for business, location, card, or analytics must validate organization membership; never trust frontend identifiers."}, {"id": "prd_merchant_funnel", "label": "Merchant Funnel (Product Analytics, Section 29)", "file_type": "concept", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical activation event is the first real card interaction."}], "edges": [{"source": "prd_smart_review_card_platform_v1", "target": "prd_reviewtap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_smart_review_card_platform_v1", "target": "prd_redirect_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_smart_review_card_platform_v1", "target": "prd_v1_non_goals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_reviewtap", "target": "prd_redirect_architecture", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_reviewtap", "target": "prd_small_business_owner", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": null, "weight": 1.0}, {"source": "prd_reviewtap", "target": "prd_reviewtap_administrator", "relation": "conceptually_r